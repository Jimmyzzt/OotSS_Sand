{
  "name": "ootss-sand-atlas",
  "private": true,
  "type": "module",
  "scripts": {
    "test:ui": "node --test tests/*.test.js",
    "test:worker": "node --test deployment/*.test.js",
    "worker:check": "python -m scripts.package_worker --complete && wrangler deploy --dry-run",
    "worker:deploy": "python -m scripts.package_worker --complete && wrangler deploy",
    "worker:package": "python -m scripts.package_worker --complete"
  },
  "devDependencies": {
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "jose": "6.2.13"
  }
}
